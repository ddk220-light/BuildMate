{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/client",
  "regions": [
    "pdx1"
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "src/server/lib/skills/domains/*.md"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
